<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Packages\com.gdsg.motorbound.foundation\Runtime\**\*.cs" Link="Foundation\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Packages\com.gdsg.motorbound.vehicle.core\Runtime\**\*.cs" Link="Vehicle.Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Packages\com.gdsg.motorbound.vehicle.physics\Runtime\TireForceModel.cs" Link="Vehicle.Physics\TireForceModel.cs" />
  </ItemGroup>
</Project>
